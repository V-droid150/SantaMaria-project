# PostgreSQL — salin ke .env lalu isi kredensial asli
DATABASE_URL="postgresql://user:password@localhost:5432/santamaria?schema=public"

# Secret untuk menandatangani session JWT — WAJIB diganti di produksi (min. 32 karakter)
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# URL publik aplikasi (untuk redirect OAuth). Kosongkan saat dev (otomatis dari request).
# NEXT_PUBLIC_APP_URL="https://app.santamaria.id"

# --- Google OAuth (opsional) ---
# Buat di https://console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Upload file (video produk) via Supabase Storage ---
# Buat bucket PUBLIC bernama "products" di Supabase -> Storage.
# SUPABASE_URL otomatis diturunkan dari DATABASE_URL bila dikosongkan.
# Service role key: Supabase -> Settings -> API -> service_role (RAHASIA, server-only).
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_URL="https://xxxx.supabase.co"   # opsional
# SUPABASE_BUCKET="products"                # opsional (default: products)

# --- Chatbot AI (Maria) ---
# API key Anthropic dari https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Opsional: ganti model. Default claude-opus-4-8. Untuk lebih hemat biaya: claude-haiku-4-5
# CHAT_MODEL="claude-haiku-4-5"
