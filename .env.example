# PostgreSQL — salin ke .env lalu isi kredensial asli
DATABASE_URL="postgresql://user:password@localhost:5432/santamaria?schema=public"

# Secret untuk menandatangani session JWT — WAJIB diganti di produksi (min. 32 karakter)
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# URL publik aplikasi (untuk redirect OAuth). Kosongkan saat dev (otomatis dari request).
# NEXT_PUBLIC_APP_URL="https://app.santamaria.id"

# --- Google OAuth (opsional) ---
# Buat di https://console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Upload file (video produk) via Supabase Storage ---
# Buat bucket PUBLIC bernama "products" di Supabase -> Storage.
# SUPABASE_URL otomatis diturunkan dari DATABASE_URL bila dikosongkan.
# Service role key: Supabase -> Settings -> API -> service_role (RAHASIA, server-only).
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_URL="https://xxxx.supabase.co"   # opsional
# SUPABASE_BUCKET="products"                # opsional (default: products)

# --- Pembayaran online (Midtrans Snap) ---
# Dari dashboard Midtrans -> Settings -> Access Keys. Pakai key Sandbox dulu utk uji coba.
# Webhook (Payment Notification URL) di Midtrans: <APP_URL>/api/payment/notification
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Disbursement otomatis ke rekening penjual (Iris by Midtrans) — opsional, butuh aktivasi Iris.
# Tanpa ini, pembayaran Snap masuk ke akun platform (belum tersalur otomatis).
MIDTRANS_IRIS_KEY=""
PLATFORM_FEE_PERCENT="0"

# --- Notifikasi Web Push (VAPID) ---
# Generate sekali: npx web-push generate-vapid-keys --json
# Public key boleh publik (dipakai browser); private key RAHASIA (server-only).
# Kosongkan untuk menonaktifkan notifikasi (app tetap jalan).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@santamaria.id"

# --- Anti-bot CAPTCHA (Cloudflare Turnstile) ---
# Gratis. Buat di https://dash.cloudflare.com -> Turnstile -> Add site.
# Site key bersifat publik (dipakai di browser); secret key RAHASIA (server-only).
# Kosongkan keduanya untuk menonaktifkan (form login/signup tetap jalan tanpa CAPTCHA).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Chatbot AI (Maria) ---
# API key Anthropic dari https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Opsional: ganti model. Default claude-opus-4-8. Untuk lebih hemat biaya: claude-haiku-4-5
# CHAT_MODEL="claude-haiku-4-5"
